{
  "name": "recent_activity",
  "attribute_key": {
    "name": "domain_sessionid"
  },
  "events": [
    {
      "event": {
        "name": "page_view"
      },
      "properties": [
        {
          "type": "atomic",
          "name": "page_title"
        }
      ]
    },
    {
      "event": {
        "name": "snowplow_ecommerce_action",
        "vendor": "com.snowplowanalytics.snowplow.ecommerce",
        "major_version": 1
      },
      "properties": [
        {
          "type": "event",
          "vendor": "com.snowplowanalytics.snowplow.ecommerce",
          "name": "snowplow_ecommerce_action",
          "major_version": 1,
          "path": "type",
          "output_name": "action"
        },
        {
          "type": "entity",
          "vendor": "com.snowplowanalytics.snowplow.ecommerce",
          "name": "product",
          "major_version": 1,
          "path": "name",
          "output_name": "product"
        }
      ]
    },
    {
      "event": {
        "name": "view_search_results"
      },
      "properties": [
        {
          "type": "atomic",
          "name": "page_title"
        }
      ]
    }
  ],
  "max_events": 20,
  "max_age_seconds": 1800
}
